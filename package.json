{
  "name": "keep-him-walking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:test": "supabase test db",
    "db:lint:remote": "node --import tsx --env-file=.env.local scripts/lint-remote-database.ts",
    "db:test:remote": "node --import tsx --env-file=.env.local scripts/test-database.ts",
    "seed:phase1": "node --import tsx --env-file=.env.local scripts/seed-phase1.ts",
    "seed:phase15:preview": "node --import tsx --env-file=.env.local scripts/seed-phase1.ts --preview",
    "reset:phase15:preview": "node --import tsx --env-file=.env.local scripts/reset-phase15-preview.ts",
    "phase2:preflight": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/preflight.ts",
    "phase2:configure-local": "node --import tsx scripts/phase2/configure-local-preview.ts",
    "phase2:configure-vercel": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/configure-vercel-preview.ts",
    "phase2:set-clock": "node --import tsx scripts/phase2/set-preview-clock.ts",
    "phase2:db:plan": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/database.ts",
    "phase2:db:apply": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/database.ts --apply",
    "db:lint:phase2": "node --import tsx --env-file=.env.phase2-preview.local scripts/lint-remote-database.ts",
    "db:test:phase2": "node --import tsx --env-file=.env.phase2-preview.local scripts/test-database.ts",
    "seed:phase2:preview": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/seed-preview.ts",
    "reset:phase2:preview": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/reset-preview.ts",
    "phase2:schedule": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/schedule-content.ts",
    "phase2:approve-sponsor": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/approve-sponsor.ts",
    "phase2:upload-creative": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/upload-sponsor-creative.ts",
    "phase2:remove-sponsor": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/remove-sponsor.ts",
    "phase2:aggregate-metrics": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/aggregate-metrics.ts",
    "phase2:smoke-rollover": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/smoke-rollover.ts",
    "phase2:replay-webhook": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/replay-webhook.ts",
    "phase2:rehearse-sponsors": "node --import tsx --env-file=.env.phase2-preview.local scripts/phase2/rehearse-sponsor-fixtures.ts",
    "art:phase2:characters": "node scripts/process-phase2-characters.mjs",
    "art:phase2": "node scripts/process-phase2-art.mjs",
    "content:validate": "node --import tsx scripts/validate-country-packs.ts",
    "assets:report": "node --import tsx scripts/report-phase15-assets.ts",
    "assets:report:phase2": "node --import tsx scripts/report-phase2-assets.ts",
    "test:motion": "vitest run src/lib/world && playwright test tests/e2e/phase15-motion.spec.ts",
    "test:motion:soak": "RUN_MOTION_SOAK=1 playwright test tests/e2e/phase15-soak.spec.ts --project=chromium",
    "motion:record": "playwright test --config=playwright.motion.config.ts",
    "motion:record:phase2": "playwright test --config=playwright.phase2-motion.config.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:phase1": "pnpm db:lint && pnpm db:test && pnpm verify && pnpm test:e2e",
    "verify:phase15": "pnpm db:lint:remote && pnpm db:test:remote && pnpm verify && pnpm content:validate && pnpm assets:report && pnpm test:e2e",
    "verify:phase1.5": "pnpm verify:phase15 && pnpm test:motion:soak",
    "verify:phase2:code": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm content:validate && pnpm assets:report:phase2",
    "verify:phase2": "pnpm verify:phase2:code && pnpm phase2:preflight && pnpm db:lint:phase2 && pnpm db:test:phase2 && pnpm test:e2e",
    "rehearse:phase2": "RUN_PHASE2_REHEARSAL=1 node --env-file=.env.phase2-preview.local node_modules/@playwright/test/cli.js test --config=playwright.phase2.config.ts",
    "rehearse:phase2:staged": "RUN_PHASE2_STAGED_REHEARSAL=1 node --env-file=.env.phase2-preview.local node_modules/@playwright/test/cli.js test --config=playwright.phase2.config.ts"
  },
  "dependencies": {
    "@rive-app/react-webgl2": "^4.33.0",
    "@rive-app/webgl2": "^2.41.0",
    "@supabase/supabase-js": "^2.112.4",
    "@vemetric/node": "^0.2.0",
    "@vemetric/web": "^0.6.1",
    "next": "^16.3.3",
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
