# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VEMETRIC_TOKEN=
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only Supabase and visitor identity configuration
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
VISITOR_HASH_SECRET=replace-with-at-least-32-random-characters

# Shared walking semantics
PRESENCE_TTL_SECONDS=50
STEPS_PER_ACTIVE_SECOND=1.8

# Optional local-only convenience for the reversible Phase 1.5 preview seed
PHASE15_PREVIEW_START_AT=

# Phase 2 remains off until the isolated preview schema and seed are ready.
PHASE2_ENABLED=false
PHASE2_PREVIEW_START_AT=
PHASE2_REHEARSAL_SCALE=144
PHASE2_REHEARSAL_MODE=false
PHASE2_SUPABASE_PROJECT_REF=
POSTCARD_UNLOCK_SECONDS=60
POSTCARD_RETENTION_DAYS=365
SUPABASE_POSTCARDS_BUCKET=khw-postcards
SUPABASE_SPONSOR_PRIVATE_BUCKET=khw-sponsor-private
SUPABASE_SPONSOR_PUBLIC_BUCKET=khw-sponsor-public

# Lemon Squeezy hosted checkout (use test mode and a $1 slot for rehearsal).
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=true
SPONSOR_RESERVATION_MINUTES=30

# Vercel invokes the daily maintenance reconciliation with this Bearer secret.
CRON_SECRET=

# Preview rehearsal payment adapter. `fixture` is rejected in Production.
SPONSOR_PAYMENT_PROVIDER=lemonsqueezy
SPONSOR_FIXTURE_SECRET=
